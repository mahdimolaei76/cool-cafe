# API URL — how the frontend reaches the Go backend.
#
# Leave this as /api for local development: Vite's dev server proxies
# /api/* to http://localhost:8080 (see vite.config.ts), where the Go
# backend runs by default (`cd backend && go run ./cmd/api`).
#
# Only set this to a full URL (e.g. http://your-server:8080/api) if the
# backend is running somewhere else — a remote/production server, a
# different port, etc. If that address isn't reachable from wherever
# you're running the frontend, every API call will fail and orders will
# only be saved locally (unsynced) until this is fixed.
# VITE_API_URL=/api

# Previous value, kept for reference — restore this if your backend is
# actually deployed at this address and reachable from here:
VITE_API_URL=http://62.60.166.110:8080/api
